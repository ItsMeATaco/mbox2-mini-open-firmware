# Only what the public repository needs is tracked. Everything else in this folder (build output, working
# notes, firmware backups, lab and measurement tools) stays local, so each path is opted in below.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CMakeLists.txt
!/firmware/
!/src/
!/pi/
!/tools/
!/docs/
!/third_party/

/firmware/out/

/docs/*
!/docs/images/

/src/*
!/src/hub/
!/src/asio/

/tools/*
!/tools/firmware/
!/tools/asio/
!/tools/setup/
/tools/firmware/*
!/tools/firmware/build.ps1
!/tools/firmware/usbeeprom.py
!/tools/firmware/winusb.py
!/tools/firmware/fwdebug.py
!/tools/firmware/diagstrings.py
/tools/asio/*
!/tools/asio/install.ps1
!/tools/asio/uninstall.ps1

# Steinberg's ASIO SDK: only its license and the three interface headers the driver includes.
/third_party/*
!/third_party/asiosdk/
/third_party/asiosdk/*
!/third_party/asiosdk/LICENSE.txt
!/third_party/asiosdk/common/
/third_party/asiosdk/common/*
!/third_party/asiosdk/common/asio.h
!/third_party/asiosdk/common/asiosys.h
!/third_party/asiosdk/common/iasiodrv.h

__pycache__/
*.log
*.wav
